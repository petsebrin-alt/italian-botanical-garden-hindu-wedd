# Copy to .env.local and fill in.
# Public URL of the invitation (used in calendar files and share text)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Secret for the couple's /studio (RSVP table, CSV export, wish moderation). 12+ characters.
STUDIO_TOKEN=
# Salt for hashing visitor connection addresses (rate limiting only)
HASH_SALT=
# Postgres for RSVPs, wishes and rate limits (required on Vercel). Neon via the
# Vercel Storage tab sets this for you; for Supabase use the transaction-pooler URL.
DATABASE_URL=
# Local development without DATABASE_URL stores JSON files here (default ./data)
DATA_DIR=
